@model UserLoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    string ErrOf(string key) => ViewData.ModelState.TryGetValue(key, out var e) ? e.Errors.FirstOrDefault()?.ErrorMessage ?? "" : "";
}

<div class="form-head">
    <h1>Tekrar hoş geldiniz 👋</h1>
    <p>Mailora hesabınıza giriş yapın ve mesajlarınıza kaldığınız yerden devam edin.</p>
    <div class="switch-link">Hesabınız yok mu? <a asp-controller="Register" asp-action="SignUp">Kayıt Ol</a></div>
</div>

<form method="post" asp-controller="Login" asp-action="SignIn" asp-route-returnUrl="@ViewBag.ReturnUrl" novalidate data-lock>
    <div asp-validation-summary="ModelOnly"></div>

    <div class="auth-stack">
        <div class="field @(string.IsNullOrEmpty(ErrOf("Username")) ? "" : "is-invalid")">
            <label asp-for="Username">Kullanıcı Adı veya E-posta <span class="req">*</span></label>
            <div class="input-wrap">
                <i class="bi bi-person lead"></i>
                <input class="a-input" asp-for="Username" type="text" placeholder="kullaniciadi veya ad@ornek.com" autocomplete="username" spellcheck="false" autocapitalize="none" autofocus>
            </div>
            <span class="field-error">@ErrOf("Username")</span>
        </div>

        <div class="field @(string.IsNullOrEmpty(ErrOf("Password")) ? "" : "is-invalid")">
            <label asp-for="Password">Şifre <span class="req">*</span></label>
            <div class="input-wrap">
                <i class="bi bi-lock lead"></i>
                <input class="a-input has-eye" asp-for="Password" id="loginPassword" type="password" placeholder="Şifreniz" autocomplete="current-password">
                <button type="button" class="eye-btn" data-eye="loginPassword" aria-label="Şifreyi göster" title="Şifreyi göster"><i class="bi bi-eye"></i></button>
            </div>
            <span class="field-error">@ErrOf("Password")</span>
        </div>

        <div class="auth-row">
            <label class="remember"><input type="checkbox" class="m-check" asp-for="RememberMe"> Beni hatırla</label>
            <a asp-controller="Password" asp-action="ForgotPassword">Şifremi unuttum</a>
        </div>
    </div>

    <button type="submit" class="btn-primary-x">
        <span class="lbl">Giriş Yap</span><i class="bi bi-arrow-right"></i>
    </button>

    <div class="secure-note"><i class="bi bi-shield-check"></i> 5 hatalı denemede hesabınız güvenlik için 5 dakika kilitlenir.</div>
    <div class="form-foot">E-postanızı doğrulamadınız mı? <a asp-controller="ConfirmMail" asp-action="Index">Doğrulama kodunu gir</a></div>
</form>
