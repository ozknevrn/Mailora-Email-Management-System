@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    var emailError = ViewData.ModelState.TryGetValue("Email", out var ee) ? ee.Errors.FirstOrDefault()?.ErrorMessage : null;
}

<div class="auth-icon"><i class="bi bi-key"></i></div>
<div class="form-head">
    <h1>Şifrenizi mi unuttunuz?</h1>
    <p>Hesabınıza kayıtlı e-posta adresini girin. Size <b>30 dakika geçerli, tek kullanımlık</b> bir şifre sıfırlama bağlantısı gönderelim.</p>
</div>

<form method="post" asp-controller="Password" asp-action="ForgotPassword" novalidate data-lock>
    <div asp-validation-summary="ModelOnly"></div>
    <div class="field @(emailError == null ? "" : "is-invalid")">
        <label asp-for="Email">E-posta <span class="req">*</span></label>
        <div class="input-wrap">
            <i class="bi bi-envelope lead"></i>
            <input class="a-input" asp-for="Email" type="email" placeholder="ad.soyad@ornek.com" autocomplete="email" autofocus>
        </div>
        <span class="field-error">@emailError</span>
    </div>

    <button type="submit" class="btn-primary-x">
        <span class="lbl">Sıfırlama Bağlantısı Gönder</span><i class="bi bi-send"></i>
    </button>

    <div class="form-foot">Şifrenizi hatırladınız mı? <a asp-controller="Login" asp-action="SignIn">Giriş Yap</a></div>
</form>
