@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni Şifre Belirle";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    string? ErrOf(string key) => ViewData.ModelState.TryGetValue(key, out var e) ? e.Errors.FirstOrDefault()?.ErrorMessage : null;
}

@if (Model.IsTokenInvalid)
{
    <div class="auth-icon warn"><i class="bi bi-link-45deg"></i></div>
    <div class="form-head">
        <h1>Bağlantı geçersiz</h1>
        <p>Bu şifre sıfırlama bağlantısı <b>geçersiz, süresi dolmuş veya daha önce kullanılmış</b>. Güvenliğiniz için her bağlantı 30 dakika geçerlidir ve yalnızca bir kez kullanılabilir.</p>
    </div>
    <a class="btn-primary-x" style="text-decoration:none" asp-controller="Password" asp-action="ForgotPassword">
        <span class="lbl">Yeni Bağlantı İste</span><i class="bi bi-arrow-repeat"></i>
    </a>
    <div class="form-foot"><a asp-controller="Login" asp-action="SignIn">Giriş sayfasına dön</a></div>
}
else
{
    <div class="auth-icon"><i class="bi bi-shield-lock"></i></div>
    <div class="form-head">
        <h1>Yeni şifrenizi belirleyin</h1>
        <p>En az 8 karakter; büyük harf, küçük harf, rakam ve özel karakter içermelidir.</p>
    </div>

    <form method="post" asp-controller="Password" asp-action="ResetPassword" novalidate data-lock>
        <input type="hidden" asp-for="UserId">
        <input type="hidden" asp-for="Token">
        <div asp-validation-summary="ModelOnly"></div>

        <div class="auth-stack">
            <div class="field @(ErrOf("NewPassword") == null ? "" : "is-invalid")">
                <label asp-for="NewPassword">Yeni Şifre <span class="req">*</span></label>
                <div class="input-wrap">
                    <i class="bi bi-lock lead"></i>
                    <input class="a-input has-eye" asp-for="NewPassword" id="newPassword" type="password" autocomplete="new-password" autofocus>
                    <button type="button" class="eye-btn" data-eye="newPassword" aria-label="Şifreyi göster"><i class="bi bi-eye"></i></button>
                </div>
                <span class="field-error">@ErrOf("NewPassword")</span>
            </div>
            <div class="field @(ErrOf("ConfirmPassword") == null ? "" : "is-invalid")">
                <label asp-for="ConfirmPassword">Yeni Şifre Tekrar <span class="req">*</span></label>
                <div class="input-wrap">
                    <i class="bi bi-shield-lock lead"></i>
                    <input class="a-input has-eye" asp-for="ConfirmPassword" id="confirmPassword" type="password" autocomplete="new-password">
                    <button type="button" class="eye-btn" data-eye="confirmPassword" aria-label="Şifreyi göster"><i class="bi bi-eye"></i></button>
                </div>
                <span class="field-error">@ErrOf("ConfirmPassword")</span>
            </div>
        </div>

        <button type="submit" class="btn-primary-x">
            <span class="lbl">Şifremi Güncelle</span><i class="bi bi-check2-circle"></i>
        </button>
    </form>
}
